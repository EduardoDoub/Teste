                                      Navigator.pop(context);
                                    }
                                  });
                                }
                              } else {
                                ScaffoldMessenger.of(context).showSnackBar(
                                    const SnackBar(
                                        content: Text(
                                            'Preencha a descrição e o valor!',
                                            style:
